# Frontend (shipped to the browser, so never put a secret in a VITE_* variable).
# "true": MSW answers the API in the browser and the app runs without the server.
# "false": the app calls the Node server (pnpm dev starts both).
VITE_ENABLE_API_MOCKING=true

# Server only.
PORT=3001
DATABASE_PATH=data/java-coach.db
CODEX_TIMEOUT_MS=180000
# CODEX_MODEL=
